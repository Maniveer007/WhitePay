# Network (defaults come from data/deployment.json)
RPC_URL=
CHAIN_ID=
DEPLOYER_KEY=            # funded key used by `npm run deploy:*`
TOKEN_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7   # Whitechain USDT; unset = deploy MockUSDT
EXPLORER_URL=
# Server
API_KEY=wp_test_demo
WEBHOOK_SECRET=whsec_demo
WEBHOOK_URL=
SAFE_CONFS=3
FINAL_CONFS=12
KEEPER_KEY=              # optional: auto-charge due subscriptions
FAUCET_KEY=              # optional: mock-token faucet
# Gasless checkout relayer (pays WBT gas for EIP-3009 payments)
RELAYER_KEY=
# Multi-merchant (platform) mode
PLATFORM_KEY=            # bearer key for POST /api/v1/platform/merchants
MERCHANT_SECRETS_KEY=    # 64 hex chars; encrypts each merchant's quote-signing key at rest
# Subscriptions
DUNNING_GRACE_DAYS=7
DUNNING_RETRY_SECONDS=3600,86400,259200,604800
RENEWAL_NOTICE_HOURS=72
# Notifications (unset = messages are logged, not sent)
PUBLIC_URL=https://pay.example.com
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=       # approved template name for business-initiated messages
MERCHANT_WHATSAPP_TO=
RESEND_API_KEY=
EMAIL_FROM=
MERCHANT_EMAIL=
# Branding
MERCHANT_NAME=
MERCHANT_COLOR=
MERCHANT_TAX_ID=
MERCHANT_ADDRESS=

# SaaS mode
SIGNUP_OPEN=0            # 1 = public self-serve signup (POST /api/v1/signup, and the /signup page of the web app)
SIGNUP_RATE_LIMIT=5      # signups per minute per IP
PLANS_JSON=              # optional JSON to override plans and prices (see server/saas.js)
PLATFORM_FEE_WALLET=     # marketplace: wallet that receives the platform fee from sellers' split-payout contracts
PLATFORM_FEE_BPS=         # fee in basis points (1000 = 10%)
SPLITTER_HOLD_DAYS=7      # days a seller's share is held before release (dispute window)
SPLITTER_ARBITER=         # wallet that can return held funds to buyers (default: the fee wallet)
TRUST_PROXY=              # which proxy hops to trust for client IPs (default: loopback and private ranges)

# --- Testnet launcher (`npm run testnet` fills most of these in for you; see README) ---
BOOTSTRAP_OWNER_EMAIL=     # first sign-in for the platform's own business
BOOTSTRAP_OWNER_PASSWORD=
PAYOUT_DELAY=60            # seconds a payout-wallet change is timelocked (86400 for real use)
TEST_WALLETS_SEED=         # words joined with _ ; funds the automated tests' wallets (testnet only)
TEST_CLOCK=                # 1 = off-chain test clock (invoices/reminders only); refused on mainnet
DEV_MAILBOX=               # 1 = read emails at /api/dev/mailbox (local use only, never on a public server)


# Email confirmation for new accounts is off by default (easy testing). Set to 1 to require it before invites, API keys and paid plans.
REQUIRE_EMAIL_VERIFICATION=0
